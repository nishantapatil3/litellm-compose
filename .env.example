# LiteLLM Environment Configuration

# Database Configuration (matches docker-compose.yml)
DATABASE_URL=postgresql://llmproxy:dbpassword9090@db:5432/litellm
STORE_MODEL_IN_DB=True

# LiteLLM Master Key (for API authentication)
# Generate a secure key: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-1234

# LiteLLM Salt Key (for encrypting secrets in DB)
# Generate a secure key: openssl rand -hex 32
LITELLM_SALT_KEY=sk-salt-1234

# UI Configuration
# Set to "True" to enable the admin UI
# (Optionally, you can set UI_USERNAME and UI_PASSWORD for basic auth)
# UI_USERNAME=admin
# UI_PASSWORD=...

# UI Configuration - Custom Root Path
# Set SERVER_ROOT_PATH to serve LiteLLM on a custom base URL path
# Requires v1.72.3 or higher and write access to UI files
SERVER_ROOT_PATH=

# Logging
# LITELLM_LOG=INFO

# Debugging (set to True for verbose logging)
# DEBUG=False

# Redis Cache
# LiteLLM uses the redis service in docker-compose.yml at redis://redis:6379/0
# REDIS_URL=redis://redis:6379/0

##################################

# OpenRouter
# Get an API key from https://openrouter.ai/ and top up your wallet
OPENROUTER_API_KEY=sk-or-v1-...
